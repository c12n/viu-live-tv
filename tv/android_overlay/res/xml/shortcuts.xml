<?xml version="1.0" encoding="utf-8"?>
<!--
  App Actions for Google Assistant: "Play <channel> on Viu Live TV".
  The fulfillment deep link is handled by MainActivity and resolved to
  a channel in Dart. (Full Google TV catalog search integration would
  additionally require a Play-published app with a media feed; the
  Android TV media-search intent in the manifest is the other half of
  the voice support.)
  NOTE: the <action>/<fulfillment>/<parameter> attributes live in the
  appactions namespace, which must be bound to the AAPT namespace URI
  (http://schemas.android.com/aapt) — with the android: prefix or the
  res-auto URI, AAPT fails resource linking ("attribute not found").
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:appactions="http://schemas.android.com/aapt">
    <capability android:name="actions.intent.PLAY_MEDIA">
        <action appactions:intentName="actions.intent.PLAY_MEDIA">
            <fulfillment appactions:value="viulivetv://play?name={name}" />
            <parameter
                appactions:name="media.name"
                appactions:key="name" />
        </action>
    </capability>
</shortcuts>
